# Environment variables for the Regulator project.
# Copy this file to .env and fill in real values. Never commit .env.

ANTHROPIC_API_KEY=your-key-here

# Model used to propose regulatory document structure during parsing (the
# deterministic, high-volume structure passes).
PARSE_MODEL=claude-haiku-4-5

# Model used for the semantic profile calls (document-kind classification and
# facet extraction in `make profiles` / the profile eval). A stronger model
# than PARSE_MODEL, since these are judgement calls rather than transcription.
PROFILE_MODEL=claude-sonnet-5
